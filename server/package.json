{
	"name": "langstore-api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "tsx watch src/api/server.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/api/server.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:repository": "vitest run --config vitest.repository.config.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"@langstore/contracts": "0.1.0",
		"@clerk/fastify": "3.1.96",
		"@fastify/cors": "^11.4.3",
		"@fastify/multipart": "10.1.7",
		"@google-cloud/documentai": "^10.2.0",
		"dotenv": "^18.0.9",
		"drizzle-orm": "0.45.4",
		"fastify": "5.12.7",
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@fastify/type-provider-json-schema-to-ts": "^5.0.1",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "0.31.11",
		"tsx": "4.23.15",
		"typescript": "6.0.3",
		"vitest": "5.0.5"
	}
}
