{
	"name": "langstore-api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"packageManager": "npm@10.2.5",
	"scripts": {
		"dev": "tsx watch src/api/server.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/api/server.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"@clerk/fastify": "3.1.96",
		"@fastify/env": "^7.0.1",
		"@fastify/multipart": "10.1.7",
		"dotenv": "^18.0.9",
		"drizzle-orm": "0.45.4",
		"fastify": "5.12.7",
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "0.31.11",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	}
}
